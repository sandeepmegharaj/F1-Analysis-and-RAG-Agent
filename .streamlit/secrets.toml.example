# Copy keys into .streamlit/secrets.toml locally or set host secrets. Never commit real values.
[openai]
api_key = ""
chat_model = "gpt-5"
embedding_model = "text-embedding-3-small"

[rag]
chunking_strategy = "recursive" # or semantic (requires embedding access)
chunk_size = 900
chunk_overlap = 120
chroma_dir = "./chroma_db"

[databricks]
gold_backend = "local_delta" # change to databricks_sql only after setup
# gold_data_dir = "./data"
# server_hostname = "<workspace-hostname>"
# http_path = "<sql-warehouse-http-path>"
# access_token = "<store privately; do not commit>"
# gold_tables = { dim_races = "catalog.schema.confirmed_name" }
