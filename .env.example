# Copy to .env locally; never commit real credentials.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CHROMA_DIR=./chroma_db
GOLD_BACKEND=local_delta
GOLD_DATA_DIR=./data
# For Databricks SQL, select databricks_sql and configure private secrets:
# GOLD_BACKEND=databricks_sql
# GOLD_TABLES={"dim_races":"catalog.schema.actual_races_table"}
# DATABRICKS_SERVER_HOSTNAME=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_TOKEN=
